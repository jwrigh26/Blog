@page 
@model IndexModel 
@{ 
  ViewData["Title"] = "Home"; 
}

<div class="blog-container">
  <div id="post-wrapper">
    <!-- Initial Sever-Rendered Posts -->
    <partial name="_BlogPostCard" model="Model.Posts" />
  </div>
  <!-- Scroll Trigger Element -->
  <div id="scroll-trigger" class="loading-indicator">
    <span>Loading more articles ...</span>
  </div>
</div>

@section Scripts {
<script>
  document.addEventListener("DOMContentLoaded", () => {
    let currentPage = 1;
    let isLoading = false;
    let hasMore = true;

    const postsWrapper = document.getElementById("post-wrapper");
    const trigger = document.getElementById("scroll-trigger");

    const observer = new IntersectionObserver(
      async (entries) => {
        const entry = entries[0];

        if (entry.isIntersecting && !isLoading && hasMore) {
          isLoading = true;
          currentPage++;

          try {
            const response = await fetch(`/Index?handler=MorePosts&page=${currentPage}`);

            if (response.status === 204) {
              hasMore = false;
              trigger.style.display = "none";
              return;
            }

            // Safety check: handle backend server errors gracefully
            if (!response.ok) {
              throw new Error(`Server responded with status ${response.status}`);
            }

            const html = await response.text();
            postsWrapper.insertAdjacentHTML("beforeend", html);
          } catch (err) {
            console.error("Error fetching more posts:", err);
            // Revert the page increment if the request failed so it retries the same page next time
            currentPage--;
          } finally {
            isLoading = false;
          }
        }
      },
      { rootMargin: "200px" },
    );

    observer.observe(trigger);
  });
</script>
}
