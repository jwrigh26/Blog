{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true, // Required for "bunder" rsoltuion (Vite handles output)
    "strict": true,
    "jsx": "react-jsx", // Required for React 18+ TSX files
    "skipLibCheck": true, // Skips type checking of .d.ts files (prevents crashes)
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": [
    "node_modules",
    "bin",
    "obj",
    "wwwroot" // Keeps TS from scanning Vite's build output
  ]
}
